#!/usr/bin/env bash
set -euo pipefail
[[ -n ${SWAYSOCK:-} && -n ${WAYLAND_DISPLAY:-} ]] || exit 1
systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
systemctl --user start fetian-sway.target
systemctl --user restart xdg-desktop-portal.service
