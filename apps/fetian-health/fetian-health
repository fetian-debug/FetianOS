#!/usr/bin/env bash
# Compatibility command: all metric collection is implemented in safe Rust.
set -euo pipefail
if ! command -v fetian-health-rs >/dev/null; then
  echo 'fetian-health: Rust backend missing. Run make native and add target/release to PATH, or rebuild the ISO.' >&2
  exit 127
fi
exec fetian-health-rs "$@"
