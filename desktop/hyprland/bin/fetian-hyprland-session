#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -ne 0 ]] || { echo 'Use a regular desktop account.' >&2; exit 1; }
[[ -n ${XDG_RUNTIME_DIR:-} ]] || { echo 'A login-managed runtime directory is required.' >&2; exit 1; }
[[ -z ${SWAYSOCK:-}${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || { echo 'Log out of the current compositor first.' >&2; exit 1; }
if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  [[ -S "$XDG_RUNTIME_DIR/bus" ]] || { echo 'A login-managed user D-Bus session is required.' >&2; exit 1; }
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
exec 9>"$XDG_RUNTIME_DIR/fetian-desktop-session.lock"
flock -n 9 || { echo 'A FetianOS desktop session is already running.' >&2; exit 1; }
version=$(pacman -Q hyprland | awk '{print $2}')
[[ $version == 0.56.2-4 ]] || { echo "Hyprland package $version does not match the pinned configuration candidate 0.56.2-4. Choose Sway recovery." >&2; exit 1; }
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
compositor_pid=""
cleanup() {
  trap - EXIT INT TERM
  if [[ -n "$compositor_pid" ]] && kill -0 "$compositor_pid" 2>/dev/null; then
    kill "$compositor_pid" 2>/dev/null || true
    wait "$compositor_pid" 2>/dev/null || true
  fi
  systemctl --user stop fetian-hyprland.target || true
  systemctl --user stop xdg-desktop-portal-hyprland.service || true
  dbus-update-activation-environment WAYLAND_DISPLAY= DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= XDG_CURRENT_DESKTOP= XDG_SESSION_DESKTOP= XDG_SESSION_TYPE= || true
  systemctl --user unset-environment HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
# The wrapper retains the lock until cleanup; compositor children must not.
Hyprland --config /usr/share/fetian/hyprland/hyprland.lua 9>&- &
compositor_pid=$!
wait "$compositor_pid"
